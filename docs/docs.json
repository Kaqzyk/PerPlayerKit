          }
        ]
      },
      {
        "header": "Project",
        "items": [
          {
            "label": "Source code",
            "href": "https://github.com/rossnoah/PerPlayerKit"
          },
          {
            "label": "Report an issue",
            "href": "https://github.com/rossnoah/PerPlayerKit/issues"
          },
          {
            "label": "License (AGPL-3.0)",
            "href": "https://github.com/rossnoah/PerPlayerKit/blob/main/LICENSE"
          }
        ]
      }
    ]
